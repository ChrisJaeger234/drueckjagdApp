# Supabase-Verbindung für die App.
# Kopiere diese Datei nach `.env` und trage die Werte aus dem Supabase-Dashboard
# ein (Project Settings → API). `.env` ist in .gitignore eingetragen.
#
# Start:  flutter run --dart-define-from-file=.env
#
# WICHTIG: Nur den öffentlichen Publishable-/Anon-Key verwenden.
# Niemals den Secret-/Service-Role-Key in die App eintragen – die App
# verweigert den Start, wenn ein solcher Schlüssel erkannt wird.

SUPABASE_URL=https://dein-projekt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Alternativ (ältere Projekte): klassischer anon-Key als JWT
# SUPABASE_ANON_KEY=eyJhbGciOi...

# Optional: Ziel des Links in der Bestätigungs-E-Mail.
# Muss in Supabase unter Authentication → URL Configuration → Redirect URLs
# eingetragen sein. Standard: de.drueckjagd.app://login-callback
# AUTH_REDIRECT_URL=de.drueckjagd.app://login-callback
